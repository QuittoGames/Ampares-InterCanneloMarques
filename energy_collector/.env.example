# ============================================================
# Energy Collector — referencia de variaveis de ambiente
# ------------------------------------------------------------
# ATENCAO (FR-008/A6): em producao NAO existe .env proprio aqui.
# O coletor le o .env do PROJETO PAI:
#     D:\Projects\Java\Ampares-InterCanneloMarques\.env
# com exatamente estas chaves (nomes legados do servidor Java):
# DB_HOST, DB_USERNAME, DB_PASSWORD, DB_PORT, DATABASE, DB_SSLMODE.
# Este arquivo existe apenas como exemplo/documentacao local.
# ============================================================

DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DATABASE=
# "require" (ou "true") => conexao criptografada obrigatoria (A6)
DB_SSLMODE=require

# OPCIONAL (A5): acesso Socrata e anonimo por padrao; o token apenas
# eleva o teto de requisicoes. Nunca commitado.
# SOCRATA_APP_TOKEN=
